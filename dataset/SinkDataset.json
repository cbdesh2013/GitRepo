{
	"name": "SinkDataset",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LinkStorage",
			"type": "LinkedServiceReference"
		},
		"folder": {
			"name": "Incremental"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@CONCAT('Incremental-', pipeline().RunId, '.csv')",
					"type": "Expression"
				},
				"container": "incremental"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}