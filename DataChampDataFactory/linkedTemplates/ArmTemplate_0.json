{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DataChampDataFactory"
		},
		"LinkSQLdb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LinkSQLdb'"
		},
		"LinkStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LinkStorage'"
		},
		"LinkSQLdb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "datachampdbserver.database.windows.net"
		},
		"LinkSQLdb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataChampDB"
		},
		"LinkSQLdb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admindb"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PipeParamsVars')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "InitializeVarFile",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "Files",
							"value": [
								"colors",
								"inventories",
								"inventory_parts",
								"part_categories",
								"parts",
								"sets",
								"themes"
							]
						}
					},
					{
						"name": "CondOnUserInput",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "InitializeVarFile",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@pipeline().parameters.IsWorkingFiles",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "InitializeListAllWithElse",
									"description": "",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "ListOfAllFiles",
										"value": "There are no values here."
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "ActivityTrueAppendVar",
									"type": "AppendVariable",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"variableName": "Files",
										"value": "inventory_sets"
									}
								},
								{
									"name": "ActivityAppendAnother",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "ActivityTrueAppendVar",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "Files",
										"value": "part_relationships"
									}
								},
								{
									"name": "ActivityInitializeVarListAll",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "ActivityAppendAnother",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "ListOfAllFiles",
										"value": {
											"value": "load @{length(variables('Files'))} files as: @{join(variables('Files'), ',')}",
											"type": "Expression"
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"IsWorkingFiles": {
						"type": "bool",
						"defaultValue": false
					}
				},
				"variables": {
					"Files": {
						"type": "Array"
					},
					"ListOfAllFiles": {
						"type": "String"
					}
				},
				"folder": {
					"name": "ParamsVars"
				},
				"annotations": [],
				"lastPublishTime": "2024-12-19T10:39:41Z"
			},
			"dependsOn": []
		},
