				},
				"parameters": {
					"TABLE_NAME": {
						"type": "string",
						"defaultValue": "data_source_table"
					}
				},
				"folder": {
					"name": "Incremental"
				},
				"annotations": [],
				"lastPublishTime": "2024-12-20T09:02:54Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/WatermarkDataset')]",
				"[concat(variables('factoryId'), '/datasets/SouraceDataset')]",
				"[concat(variables('factoryId'), '/datasets/SinkDataset')]",
